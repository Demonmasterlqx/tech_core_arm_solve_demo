<?xml version='1.0' encoding='utf-8'?>
<robot name="pie_eng">
  <!--CAD geometry in metres. Zero angles preserve saved assembly pose. Limits are visualization defaults, not hardware safety limits.-->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/base_link.stl" scale="1 1 1" />
      </geometry>
      <material name="cad_visual_0">
        <color rgba="0.22 0.25 0.29 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/base_link.stl" scale="1 1 1" />
      </geometry>
    </collision>
  </link>
  <link name="yaw_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/yaw_link.stl" scale="1 1 1" />
      </geometry>
      <material name="cad_visual_1">
        <color rgba="0.66 0.70 0.75 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/yaw_link.stl" scale="1 1 1" />
      </geometry>
    </collision>
  </link>
  <link name="upper_arm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/upper_arm.stl" scale="1 1 1" />
