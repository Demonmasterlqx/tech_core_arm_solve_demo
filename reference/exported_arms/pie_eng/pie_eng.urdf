    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/forearm_roll.stl" scale="1 1 1" />
      </geometry>
    </collision>
  </link>
  <link name="wrist_pitch">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/wrist_pitch.stl" scale="1 1 1" />
