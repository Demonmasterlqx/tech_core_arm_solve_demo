    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/upper_arm.stl" scale="1 1 1" />
      </geometry>
    </collision>
  </link>
  <link name="forearm">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/forearm.stl" scale="1 1 1" />
      </geometry>
      <material name="cad_visual_3">
        <color rgba="0.55 0.59 0.64 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/forearm.stl" scale="1 1 1" />
      </geometry>
    </collision>
  </link>
  <link name="forearm_roll">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/forearm_roll.stl" scale="1 1 1" />
      </geometry>
