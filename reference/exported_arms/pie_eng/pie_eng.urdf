    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/wrist_pitch.stl" scale="1 1 1" />
      </geometry>
    </collision>
  </link>
  <link name="tool_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/tool_link.stl" scale="1 1 1" />
      </geometry>
      <material name="cad_visual_6">
        <color rgba="0.32 0.39 0.48 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/tool_link.stl" scale="1 1 1" />
      </geometry>
    </collision>
  </link>
  <link name="jaw_left">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/jaw_left.stl" scale="1 1 1" />
      </geometry>
      <material name="cad_visual_7">
        <color rgba="0.18 0.21 0.25 1" />
