    <origin xyz="0.0342957404 -0.0007596455898 0.05241946708" rpy="0 0 0" />
    <axis xyz="0.8771931597 0.4792026253 -0.02995003212" />
    <limit lower="-0.6" upper="0.6" effort="0" velocity="0" />
    <mimic joint="gripper_open" multiplier="-1" offset="0" />
