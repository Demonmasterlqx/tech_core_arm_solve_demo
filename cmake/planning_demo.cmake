find_package(Threads REQUIRED)
add_library(tech_core_planning_demo src/planning_demo.cpp)
add_library(rm26_planning_demo ALIAS tech_core_planning_demo)
set_target_properties(tech_core_planning_demo PROPERTIES OUTPUT_NAME rm26_planning_demo)
target_link_libraries(tech_core_planning_demo PUBLIC tech_core_planning Threads::Threads)
target_compile_options(tech_core_planning_demo PRIVATE -Wall -Wextra -Wpedantic)
if(TECH_CORE_VIEWER)
  add_executable(arm_demo src/planning_demo_main.cpp)
  target_link_libraries(arm_demo PRIVATE rm26_planning_demo glfw OpenGL::GL PNG::PNG)
  target_compile_options(arm_demo PRIVATE -Wall -Wextra -Wpedantic)
  add_executable(rm26_demo src/planning_demo_main.cpp)
  target_link_libraries(rm26_demo PRIVATE rm26_planning_demo glfw OpenGL::GL PNG::PNG)
  target_compile_options(rm26_demo PRIVATE -Wall -Wextra -Wpedantic)
endif()
if(BUILD_TESTING)
  add_executable(planning_demo_test tests/planning_demo_test.cpp)
  target_link_libraries(planning_demo_test PRIVATE rm26_planning_demo)
  target_compile_options(planning_demo_test PRIVATE -Wall -Wextra -Wpedantic)
  add_test(NAME planning_demo_contract COMMAND planning_demo_test)
  set_tests_properties(planning_demo_contract PROPERTIES TIMEOUT 60)
  if(TECH_CORE_VIEWER)
    add_test(NAME planning_demo_help COMMAND rm26_demo --help)
    add_test(NAME planning_demo_invalid_backend COMMAND rm26_demo --backend atlas)
    set_tests_properties(planning_demo_invalid_backend PROPERTIES WILL_FAIL TRUE)
  endif()
endif()
if(BUILD_TESTING)
  add_executable(multi_arm_test tests/multi_arm_test.cpp)
  target_link_libraries(multi_arm_test PRIVATE rm26_planning_demo tech_core_arm)
  target_compile_options(multi_arm_test PRIVATE -Wall -Wextra -Wpedantic)
  add_test(NAME multi_arm_contract COMMAND multi_arm_test)
  set_tests_properties(multi_arm_contract PROPERTIES TIMEOUT 60)
  add_test(NAME mec_arm_control COMMAND arm_control --robot mec_arm --headless --demo --duration .3)
  add_test(NAME mec_arm_invalid_dimension COMMAND arm_control --robot mec_arm --headless --position 0,0,0,0,0,0,0)
  add_test(NAME robot_unknown COMMAND arm_control --robot missing_robot --headless)
  set_tests_properties(mec_arm_invalid_dimension robot_unknown PROPERTIES WILL_FAIL TRUE)
endif()
if(BUILD_TESTING)
  find_package(Python3 COMPONENTS Interpreter QUIET)
  if(Python3_Interpreter_FOUND)
  add_test(NAME external_robot_import COMMAND "${Python3_EXECUTABLE}"
    "${PROJECT_SOURCE_DIR}/tests/robot_import_test.py" --control "$<TARGET_FILE:arm_control>")
  set_tests_properties(external_robot_import PROPERTIES TIMEOUT 30)
  endif()
endif()
if(BUILD_TESTING)
  add_executable(mec_arm_assembly_test tests/mec_arm_assembly_test.cpp)
  target_link_libraries(mec_arm_assembly_test PRIVATE tech_core_planning_demo)
  add_test(NAME mec_arm_assembly COMMAND mec_arm_assembly_test)
  set_tests_properties(mec_arm_assembly PROPERTIES TIMEOUT 90)
endif()
