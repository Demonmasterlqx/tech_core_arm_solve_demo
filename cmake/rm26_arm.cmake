add_library(rm26_arm_sim src/arm_simulation.cpp)
target_include_directories(rm26_arm_sim PUBLIC "${PROJECT_SOURCE_DIR}/include")
target_link_libraries(rm26_arm_sim PUBLIC mujoco)
target_compile_definitions(rm26_arm_sim PUBLIC
  TECH_CORE_ARM_MODEL_PATH="${PROJECT_SOURCE_DIR}/models/rm26_arm/scene.xml")
add_executable(rm26_arm src/arm_main.cpp)
target_link_libraries(rm26_arm PRIVATE rm26_arm_sim)
if(TECH_CORE_VIEWER)
  target_sources(rm26_arm PRIVATE src/arm_viewer.cpp)
  target_link_libraries(rm26_arm PRIVATE glfw OpenGL::GL PNG::PNG)
  target_compile_definitions(rm26_arm PRIVATE TECH_CORE_VIEWER=1)
endif()
foreach(target rm26_arm_sim rm26_arm)
  target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
endforeach()
if(BUILD_TESTING)
  add_executable(arm_test tests/arm_test.cpp)
  target_link_libraries(arm_test PRIVATE rm26_arm_sim)
  target_compile_options(arm_test PRIVATE -Wall -Wextra -Wpedantic)
  target_compile_definitions(arm_test PRIVATE TECH_CORE_SOURCE_DIR="${PROJECT_SOURCE_DIR}")
  add_test(NAME rm26_arm_control COMMAND arm_test)
  add_test(NAME rm26_arm_idle COMMAND rm26_arm --headless --duration 0.2)
  add_test(NAME rm26_arm_demo COMMAND rm26_arm --headless --demo --duration 3)
  add_test(NAME rm26_arm_cartesian COMMAND rm26_arm --headless --cartesian 0.03,0,0 --duration 0.5)
  add_test(NAME rm26_arm_invalid_velocity COMMAND rm26_arm --headless --velocity nan)
  add_test(NAME rm26_arm_conflicting_commands COMMAND rm26_arm --headless --demo --cartesian 0,0,0)
  set_tests_properties(rm26_arm_invalid_velocity rm26_arm_conflicting_commands PROPERTIES WILL_FAIL TRUE)
endif()
