find_package(Eigen3 3.3 REQUIRED NO_MODULE)
add_library(tech_core_kinematics src/planning_ik.cpp src/arm_kinematics.cpp)
target_link_libraries(tech_core_kinematics PUBLIC Eigen3::Eigen tech_core_robot)
target_compile_options(tech_core_kinematics PRIVATE -Wall -Wextra -Wpedantic)
add_executable(arm_kinematics_example examples/robot_kinematics.cpp)
target_link_libraries(arm_kinematics_example PRIVATE tech_core_kinematics)
add_library(tech_core_planning src/planning_scene.cpp src/planning_approach.cpp src/planning.cpp)
target_include_directories(tech_core_planning PUBLIC "${PROJECT_SOURCE_DIR}/include")
target_link_libraries(tech_core_planning PUBLIC Eigen3::Eigen tech_core_sim tech_core_kinematics)
target_compile_definitions(tech_core_planning PUBLIC
  TECH_CORE_PLANNING_MODEL_PATH="${PROJECT_SOURCE_DIR}/models/planning/scene.xml")
target_compile_options(tech_core_planning PRIVATE -Wall -Wextra -Wpedantic)
add_library(rm26_planning ALIAS tech_core_planning)
set_target_properties(tech_core_planning PROPERTIES OUTPUT_NAME rm26_planning)
add_executable(arm_plan src/planning_main.cpp)
target_link_libraries(arm_plan PRIVATE tech_core_planning)
target_compile_options(arm_plan PRIVATE -Wall -Wextra -Wpedantic)
add_executable(rm26_plan src/planning_main.cpp)
target_link_libraries(rm26_plan PRIVATE rm26_planning)
target_compile_options(rm26_plan PRIVATE -Wall -Wextra -Wpedantic)

# User-facing library example and the fixed-corpus evaluator share the same
# dependency graph, compiler configuration and model paths as the planner.
add_executable(arm_plan_example examples/plan_assembly.cpp)
target_link_libraries(arm_plan_example PRIVATE tech_core_planning)
add_executable(rm26_plan_example examples/plan_assembly.cpp)
target_link_libraries(rm26_plan_example PRIVATE rm26_planning)
target_compile_options(rm26_plan_example PRIVATE -Wall -Wextra -Wpedantic)
add_executable(planner_quality_benchmark src/planner_quality_main.cpp)
target_link_libraries(planner_quality_benchmark PRIVATE rm26_planning)
target_compile_options(planner_quality_benchmark PRIVATE -Wall -Wextra -Wpedantic)
if(BUILD_TESTING)
  add_executable(robot_probe tests/robot_probe.cpp)
  target_link_libraries(robot_probe PRIVATE tech_core_kinematics)
  add_test(NAME mec_arm_kinematics_example COMMAND arm_kinematics_example mec_arm)
  add_test(NAME rm26_kinematics_example COMMAND arm_kinematics_example rm26)
  add_test(NAME planning_library_example COMMAND rm26_plan_example)
  set_tests_properties(planning_library_example PROPERTIES TIMEOUT 20)
  add_executable(planning_ik_test tests/planning_ik_test.cpp)
  target_link_libraries(planning_ik_test PRIVATE rm26_planning)
  add_test(NAME planning_ik COMMAND planning_ik_test)
  add_executable(planning_contract_test tests/planning_contract_test.cpp)
  target_link_libraries(planning_contract_test PRIVATE rm26_planning)
  add_test(NAME planning_contract COMMAND planning_contract_test)
  add_executable(planning_approach_test tests/planning_approach_test.cpp)
  target_link_libraries(planning_approach_test PRIVATE rm26_planning)
  target_compile_options(planning_approach_test PRIVATE -Wall -Wextra -Wpedantic)
  add_test(NAME planning_approach COMMAND planning_approach_test)
  set_tests_properties(planning_approach PROPERTIES TIMEOUT 60)
  add_executable(planning_scene_test tests/planning_scene_test.cpp)
  target_link_libraries(planning_scene_test PRIVATE rm26_planning)
  target_compile_definitions(planning_scene_test PRIVATE
    TECH_CORE_ARM_MODEL_PATH="${PROJECT_SOURCE_DIR}/models/rm26_arm/scene.xml")
  add_test(NAME planning_scene COMMAND planning_scene_test)
endif()
